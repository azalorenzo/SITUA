<TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="creado_en" ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">datetime(6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="actualizado_en" ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">datetime(6)</FONT></TD></TR></TABLE>>];
