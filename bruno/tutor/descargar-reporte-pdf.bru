meta {
  name: Descargar PDF de un reporte del tutor
  type: http
  seq: 46
}

get {
  url: {{url_api}}/tutor/reportes/{{reporte_tutor_id}}/pdf
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token_tutor}}
  Accept: application/pdf
}

tests {
  test("Devuelve un PDF", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("content-type")).to.include("application/pdf");
  });
}
