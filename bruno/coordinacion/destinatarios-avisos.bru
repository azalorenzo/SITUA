meta {
  name: Consultar avisos/destinatarios
  type: http
  seq: 15
}

get {
  url: {{url_api}}/coordinacion/avisos/destinatarios
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token_coordinacion}}
}

tests {
  test("Devuelve contenido paginado de coordinación", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().contenido).to.be.an("array");
    expect(res.getBody().totalRegistros).to.be.a("number");
    expect(res.getBody().pagina).to.equal(1);
  });
}
