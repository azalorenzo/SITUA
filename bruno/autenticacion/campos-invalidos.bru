meta {
  name: Campos inválidos
  type: http
  seq: 4
}

post {
  url: {{url_api}}/autenticacion/iniciar-sesion
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"correo":"invalido","contrasena":"corta"}
}

tests {
  test("Devuelve los errores de cada campo", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().erroresPorCampo.correo).to.be.an("array");
    expect(res.getBody().erroresPorCampo.contrasena).to.be.an("array");
  });
}
