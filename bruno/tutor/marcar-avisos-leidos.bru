meta {
  name: Marcar todos los avisos del tutor como leídos
  type: http
  seq: 27
}

patch {
  url: {{url_api}}/tutor/avisos/leer-todos
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token_tutor}}
}

tests {
  test("Responde cuántos avisos marcó", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().marcados).to.be.a("number");
  });
}
