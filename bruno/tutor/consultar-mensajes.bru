meta {
  name: Consultar mensajes de una conversación
  type: http
  seq: 42
}

get {
  url: {{url_api}}/tutor/mensajes/conversaciones/{{conversacion_id}}/mensajes
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token_tutor}}
}

tests {
  test("Devuelve los mensajes en orden cronológico", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
  });
}
