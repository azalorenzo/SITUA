meta {
  name: Iniciar sesión de estudiante
  type: http
  seq: 1
}

post {
  url: {{url_api}}/autenticacion/iniciar-sesion
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"correo":"estudiante@demo.example","contrasena":"AlumnoDemo!2026"}
}

script:post-response {
  if (res.getStatus() === 200) bru.setVar("token_acceso", res.getBody().token);
}

tests {
  test("Devuelve un token y el rol del estudiante", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().tipoToken).to.equal("Bearer");
    expect(res.getBody().usuario.roles).to.include("estudiante");
    expect(res.getBody().token).to.be.a("string");
    expect(res.getBody().usuario).not.to.have.property("contrasenaHash");
    expect(res.getBody().usuario).not.to.have.property("password_hash");
  });
}
