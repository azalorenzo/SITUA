digraph tutoria {
 graph [rankdir=LR, bgcolor="white", pad=0.6, nodesep=0.6, ranksep=1.6, splines=polyline, concentrate=false, fontname="Arial", fontsize=22, label="TUTORIA · Modelo físico en MySQL 26.10.0\n27 tablas · 236 columnas · 45 claves foráneas\nPK = primaria | FK = foránea | UQ = única individual | ? = admite NULL\nEtiquetas de relación: 0..1 / 1 padre por hijo; 0..N / 0..1 hijos por padre", labelloc=t];
 node [shape=plain, fontname="Arial"];
 edge [color="#66849b", penwidth=1.2, arrowsize=0.7, fontname="Arial", fontsize=10];
 subgraph cluster_0 { label="Identidad y organización"; style="rounded"; color="#bbc8d5"; bgcolor="#fafbfd"; fontsize=20;
 "usuarios" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a7b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#dceff6" ALIGN="LEFT"><B>usuarios</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">PK</FONT></TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">bigint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="nombre" ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">varchar(160)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">UQ</FONT></TD><TD PORT="correo" ALIGN="LEFT">correo</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">varchar(254)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="password_hash" ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="telefono" ALIGN="LEFT">telefono ?</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="avatar_url" ALIGN="LEFT">avatar_url ?</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">varchar(1024)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="estado" ALIGN="LEFT">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">enum('activo','inactivo')</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="creado_en" ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">datetime(6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="actualizado_en" ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">datetime(6)</FONT></TD></TR></TABLE>>];
 "roles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a7b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#dceff6" ALIGN="LEFT"><B>roles</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">PK</FONT></TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">bigint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">UQ</FONT></TD><TD PORT="codigo" ALIGN="LEFT">codigo</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="nombre" ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="creado_en" ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">datetime(6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="actualizado_en" ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">datetime(6)</FONT></TD></TR></TABLE>>];
