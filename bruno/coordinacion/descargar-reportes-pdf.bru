meta {
  name: Descargar PDF de reportes pendientes
  type: http
  seq: 18
}

get {
  url: {{url_api}}/coordinacion/reportes/exportar/pdf?estado=pendiente
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token_coordinacion}}
  Accept: application/pdf, application/json
}

tests {
  test("Genera un PDF sin cambiar el estado de los reportes", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("content-type")).to.include("application/pdf");
    expect(res.getHeader("content-disposition")).to.include("attachment");
    expect(res.getHeader("cache-control")).to.equal("no-store");
  });
}
