meta {
  name: Sesión sin token
  type: http
  seq: 5
}

get {
  url: {{url_api}}/autenticacion/sesion
  body: none
  auth: none
}

tests {
  test("No permite consultar una sesión sin JWT", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().estado).to.equal(401);
  });
}
