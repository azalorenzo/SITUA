meta {
  name: Consultar estudiantes del tutor
  type: http
  seq: 28
}

get {
  url: {{url_api}}/tutor/estudiantes
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token_tutor}}
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody().length > 0) bru.setVar("estudiante_id", res.getBody()[0].id);
}

tests {
  test("Devuelve los estudiantes asignados al tutor conectado", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
  });
}
