meta {
  name: Iniciar sesión de tutor
  type: http
  seq: 20
}

post {
  url: {{url_api}}/autenticacion/iniciar-sesion
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"correo":"tutor@demo.example","contrasena":"TutorDemo!2026"}
}

script:post-response {
  if (res.getStatus() === 200) bru.setVar("token_tutor", res.getBody().token);
}

tests {
  test("Obtiene acceso de tutor", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().usuario.roles).to.include("tutor");
  });
}
