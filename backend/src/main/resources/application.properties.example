spring.application.name=backend

# Tomamos los datos locales sin guardar contraseñas en este archivo.
spring.config.import=optional:file:.env[.properties],optional:file:backend/.env[.properties]

spring.datasource.url=jdbc:mysql://${BD_SERVIDOR:127.0.0.1}:${BD_PUERTO:3306}/${BD_NOMBRE:tutoria}?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
spring.datasource.username=${BD_USUARIO}
spring.datasource.password=${BD_CONTRASENA}

# Las tablas ya existen y no queremos que Hibernate las cambie.
spring.jpa.hibernate.ddl-auto=none
spring.sql.init.mode=never
spring.jpa.open-in-view=false
