meta {
  name: Consultar inicio
  type: http
  seq: 19
}
get {
  url: {{url_api}}/coordinacion/inicio
  body: none
  auth: none
}
headers {
  Authorization: Bearer {{token_coordinacion}}
}
tests {
  test("Resumen real de coordinación", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().indicadores.totalEstudiantes).to.be.a("number");
    expect(res.getBody().mensual).to.have.lengthOf(6);
    expect(res.getBody().motivos).to.be.an("array");
  });
}
