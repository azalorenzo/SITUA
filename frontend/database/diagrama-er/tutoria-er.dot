 "tokens_recuperacion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a7b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#f8e2e7" ALIGN="LEFT"><B>tokens_recuperacion</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">PK</FONT></TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">bigint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">FK</FONT></TD><TD PORT="usuario_id" ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">bigint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">UQ</FONT></TD><TD PORT="token_hash" ALIGN="LEFT">token_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">char(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="vence_en" ALIGN="LEFT">vence_en</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">datetime(6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="utilizado_en" ALIGN="LEFT">utilizado_en ?</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">datetime(6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="creado_en" ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">datetime(6)</FONT></TD></TR></TABLE>>];
 "tokens_revocados" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a7b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#f8e2e7" ALIGN="LEFT"><B>tokens_revocados</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">PK</FONT></TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">bigint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">FK</FONT></TD><TD PORT="usuario_id" ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">bigint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">UQ</FONT></TD><TD PORT="jti" ALIGN="LEFT">jti</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">varchar(128)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="vence_en" ALIGN="LEFT">vence_en</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">datetime(6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="revocado_en" ALIGN="LEFT">revocado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">datetime(6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="motivo" ALIGN="LEFT">motivo</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">enum('logout','cambio_password','administracion')</FONT></TD></TR></TABLE>>];
 "envios_comunicacion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a7b8" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#f8e2e7" ALIGN="LEFT"><B>envios_comunicacion</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">PK</FONT></TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">bigint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">FK</FONT></TD><TD PORT="usuario_id" ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">bigint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">FK</FONT></TD><TD PORT="sesion_id" ALIGN="LEFT">sesion_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">bigint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="canal" ALIGN="LEFT">canal</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">enum('correo','sms','whatsapp')</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="destinatario" ALIGN="LEFT">destinatario</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">varchar(254)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="tipo_evento" ALIGN="LEFT">tipo_evento</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">UQ</FONT></TD><TD PORT="clave_idempotencia" ALIGN="LEFT">clave_idempotencia</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">varchar(128)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="estado" ALIGN="LEFT">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">enum('pendiente','en_proceso','enviado','entregado','fallido')</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="proveedor" ALIGN="LEFT">proveedor ?</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="id_externo" ALIGN="LEFT">id_externo ?</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="intentos" ALIGN="LEFT">intentos</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">smallint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="codigo_error" ALIGN="LEFT">codigo_error ?</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="detalle_error" ALIGN="LEFT">detalle_error ?</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="programado_en" ALIGN="LEFT">programado_en ?</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">datetime(6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="enviado_en" ALIGN="LEFT">enviado_en ?</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">datetime(6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="entregado_en" ALIGN="LEFT">entregado_en ?</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">datetime(6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="creado_en" ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">datetime(6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#48637a">&#160;</FONT></TD><TD PORT="actualizado_en" ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#48637a">datetime(6)</FONT></TD></TR></TABLE>>];
