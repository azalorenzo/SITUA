meta {
  name: Consultar periodos de coordinación
  type: http
  seq: 10
}

get {
  url: {{url_api}}/coordinacion/periodos
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token_coordinacion}}
}

tests {
  test("Consulta periodos con el token de coordinación", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
  });
}
