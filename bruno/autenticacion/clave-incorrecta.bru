meta {
  name: Contraseña incorrecta
  type: http
  seq: 3
}

post {
  url: {{url_api}}/autenticacion/iniciar-sesion
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"correo":"estudiante@demo.example","contrasena":"Incorrecta!2026"}
}

tests {
  test("Rechaza las credenciales con un mensaje claro", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().mensaje).to.equal("El correo o la contraseña son incorrectos.");
  });
}
