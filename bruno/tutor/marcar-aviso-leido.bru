meta {
  name: Marcar aviso del tutor como leído
  type: http
  seq: 26
}

patch {
  url: {{url_api}}/tutor/avisos/{{aviso_id}}/leer
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token_tutor}}
}

tests {
  test("El aviso queda con fecha de lectura", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().leidoEn).to.not.equal(null);
  });
}
