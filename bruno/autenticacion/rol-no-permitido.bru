meta {
  name: Estudiante sin permiso de coordinación
  type: http
  seq: 6
}

get {
  url: {{url_api}}/coordinacion/comprobar
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token_acceso}}
}

tests {
  test("Impide acceder a las rutas reservadas a coordinación", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().estado).to.equal(403);
  });
}
