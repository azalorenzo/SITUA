[mysqld]
basedir=/opt/situa/motor
datadir=/var/lib/situa-mysql
socket=/run/situa-mysql/mysql.sock
pid-file=/run/situa-mysql/mysql.pid
log-error=/var/log/situa/mysql/servidor.log
port=3307
bind-address=127.0.0.1
mysqlx=OFF
skip-name-resolve
disable-log-bin
innodb_buffer_pool_size=192M
innodb_redo_log_capacity=64M
max_connections=30
performance_schema=OFF
table_open_cache=256
tmp_table_size=16M
max_heap_table_size=16M
temptable_max_ram=32M
