meta {
  name: Consultar reportes
  type: http
  seq: 16
}

get {
  url: {{url_api}}/coordinacion/reportes
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token_coordinacion}}
}

tests {
  test("Consulta reportes con acceso de coordinación", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().contenido).to.be.an("array");
    expect(res.getBody().resumen.total).to.be.a("number");
  });
}
