GOOGLE_CLIENTE_ID=

# Para activar el envío, completa estos datos y cambia habilitado a true.
CORREO_HABILITADO=false
CORREO_SERVIDOR=smtp.gmail.com
CORREO_PUERTO=587
CORREO_USUARIO=
CORREO_CONTRASENA=
