# Copia este archivo como .env y completa tus datos de MySQL.
BD_SERVIDOR=127.0.0.1
BD_PUERTO=3306
BD_NOMBRE=tutoria
BD_USUARIO=tu_usuario
BD_CONTRASENA=tu_contrasena

# Genera una clave aleatoria de al menos 32 bytes y escríbela en Base64.
JWT_CLAVE=REEMPLAZAR_CON_UNA_CLAVE_GENERADA
JWT_MINUTOS_VIGENCIA=15
ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:5173

GOOGLE_CLIENTE_ID=

# Para activar el envío, completa estos datos y cambia habilitado a true.
CORREO_HABILITADO=false
CORREO_SERVIDOR=smtp.gmail.com
CORREO_PUERTO=587
CORREO_USUARIO=
CORREO_CONTRASENA=
CORREO_REMITENTE=
CORREO_SSL=false
