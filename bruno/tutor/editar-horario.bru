meta {
  name: Editar horario del tutor
  type: http
  seq: 23
}

put {
  url: {{url_api}}/tutor/horarios/{{horario_id}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token_tutor}}
}

body:json {
  {"inicioEn":"2031-03-10T16:00:00","finEn":"2031-03-10T18:00:00","ubicacion":"https://meet.example.invalid/sala"}
}

tests {
  test("Actualiza el horario y lo marca como virtual", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().modalidad).to.equal("virtual");
  });
}
