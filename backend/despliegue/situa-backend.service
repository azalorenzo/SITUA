[Unit]
Description=Backend Spring Boot de SITUA
Requires=situa-mysql.service
After=network.target situa-mysql.service
[Service]
Type=simple
User=situa
Group=situa
WorkingDirectory=/opt/situa
EnvironmentFile=/etc/situa/.env
ExecStart=/usr/bin/java -Xms64m -Xmx256m -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=64m -jar /opt/situa/actual/aplicacion.jar --server.port=8095 --server.address=127.0.0.1 --server.forward-headers-strategy=native --spring.datasource.hikari.maximum-pool-size=8 --spring.datasource.hikari.minimum-idle=2
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
MemoryHigh=512M
MemoryMax=640M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
